var steps=[].slice.call(document.querySelectorAll(".step"));
var idx=0, started=false, t0=0, tick=null;
var picks=CASES.map(function(){return []});
var done=CASES.map(function(){return false});
var caseComplete=CASES.map(function(){return false});
var results=CASES.map(function(){return null});
var ctqScore={ok:0,total:0};
var introQuestions=[].slice.call(steps[1].querySelectorAll(".quizblock .q"));
var finalQuestions=[].slice.call(steps[steps.length-1].querySelectorAll(".quizblock .q"));
var introAnswered=0, introCaseComplete=false, finalAnswered=0, finished=false;

var totalMin=steps.reduce(function(s,el){return s+parseInt(el.getAttribute("data-mins"),10)},0);
$("total").textContent="/ "+totalMin+":00";

var spine=$("spine");
steps.forEach(function(){spine.appendChild(document.createElement("i"))});
var bars=[].slice.call(spine.children);

function pad(n){return (n<10?"0":"")+n}
function fmt(s){return pad(Math.floor(s/60))+":"+pad(s%60)}
function runClock(){
  var s=Math.floor((Date.now()-t0)/1000), c=$("clock");
  c.firstElementChild.textContent=fmt(s);
  c.classList.toggle("over", s>totalMin*60);
}
function startClock(){
  if(started) return;
  started=true; t0=Date.now(); runClock(); tick=setInterval(runClock,1000);
}
$("main").addEventListener("click",startClock,{once:true});

function refreshNext(){
  var last=idx===steps.length-1;
  var allowed=true;
  if(idx===1) allowed=introAnswered===introQuestions.length && introCaseComplete;
  if(idx>=2 && idx<=CASES.length+1) allowed=caseComplete[idx-2];
  if(last) allowed=finalAnswered===finalQuestions.length && !finished;
  $("next").disabled=!allowed;
  $("next").textContent=last ? (finished ? "Atelier terminé" : "Terminer l'atelier") : "Suivant";

  if(idx===1 && introAnswered<introQuestions.length){
    $("hint").textContent="Introduction : "+introAnswered+" / "+introQuestions.length+" réponses";
  } else if(idx===1 && !introCaseComplete){
    $("hint").textContent="Cas d'école : choisissez la conduite à tenir";
  } else if(idx===1){
    $("hint").textContent="Introduction terminée · vous pouvez continuer";
  } else if(idx>=2 && idx<=CASES.length+1 && !caseComplete[idx-2]){
    $("hint").textContent=done[idx-2]
      ? "Étape 2/2 : choisissez la conduite à tenir"
      : "Étape 1/2 : validez la chronologie";
  } else if(last && !finished){
    $("hint").textContent="Synthèse : "+finalAnswered+" / "+finalQuestions.length+" réponses";
  } else if(finished){
    $("hint").textContent="Parcours terminé";
  } else if(idx>=2 && idx<=CASES.length+1){
    $("hint").textContent="Cas terminé · vous pouvez continuer";
  }
}

function show(i){
  idx=Math.max(0,Math.min(steps.length-1,i));
  steps.forEach(function(s,n){s.classList.toggle("on",n===idx)});
  bars.forEach(function(b,n){b.className = n<idx?"done":(n===idx?"now":"")});
  $("prev").disabled = idx===0;
  var m=steps[idx].getAttribute("data-mins");
  $("budget").textContent="Séquence "+(idx+1)+" / "+steps.length+" · "+m+" min";
  $("hint").textContent="Temps conseillé : "+m+" min";
  if(idx===steps.length-1) updateScore();
  refreshNext();
  window.scrollTo({top:0,behavior:"instant"});
}
function finishWorkshop(){
  if(finalAnswered!==finalQuestions.length || finished) return;
  finished=true;
  clearInterval(tick);
  $("completion").classList.remove("hidden");
  refreshNext();
  try{ $("completion").scrollIntoView({behavior:"smooth",block:"center"}) }catch(err){ try{ $("completion").scrollIntoView(true) }catch(e2){} }
}
function advance(){
  if($("next").disabled) return;
  startClock();
  if(idx===steps.length-1){finishWorkshop();return;}
  show(idx+1);
}
$("next").addEventListener("click",advance);
$("prev").addEventListener("click",function(){show(idx-1)});
document.addEventListener("keydown",function(e){
  if(e.target.matches("input,textarea")) return;
  if($("mask").classList.contains("open")){ if(e.key==="Escape") closeModal(); return; }
  if(e.key==="ArrowRight"){advance()}
  if(e.key==="ArrowLeft"){show(idx-1)}
});

[].forEach.call(document.querySelectorAll(".quizblock .q"),function(q){
  var ans=parseInt(q.getAttribute("data-answer"),10);
  var opts=[].slice.call(q.querySelectorAll(".opt"));
  opts.forEach(function(btn,i){
    btn.addEventListener("click",function(){
      opts.forEach(function(b,j){
        b.disabled=true;
        b.classList.add(j===ans?"right":(j===i?"wrong":"picked"));
        if(j!==ans&&j!==i) b.classList.remove("picked");
      });
      q.querySelector(".fb").classList.add("show");
      var step=q.closest(".step");
      if(step===steps[1]) introAnswered++;
      if(step===steps[steps.length-1]) finalAnswered++;
      refreshNext();
    });
  });
});

document.addEventListener("click",function(e){
  var b=e.target.closest ? e.target.closest(".ev") : null;
  if(!b) return;
  var ci=parseInt(b.getAttribute("data-c"),10), i=parseInt(b.getAttribute("data-i"),10);
  if(done[ci]) return;
  var arr=picks[ci], p=arr.indexOf(i);
  if(p>-1){arr.splice(p,1); b.classList.remove("sel")}
  else {arr.push(i); b.classList.add("sel")}
  var n=arr.length;
  $("cnt"+ci).textContent = n===0 ? "Aucun moment sélectionné"
    : (n===1 ? "1 moment sélectionné" : n+" moments sélectionnés");
  document.querySelector('[data-check="'+ci+'"]').disabled = n===0;
});

document.addEventListener("click",function(e){
  var b=e.target.closest ? e.target.closest("[data-check]") : null;
  if(!b||b.disabled) return;
  checkTimeline(parseInt(b.getAttribute("data-check"),10));
});

var current=null, currentCtq=null, chosen=null;

function openModal(key,ctq,kicker){
  current=key; currentCtq=ctq; chosen=null;
  $("m-kicker").textContent=kicker;
  $("m-title").textContent=ctq.question;
  $("m-warn").classList.remove("show");
  var list=$("m-list");
  list.innerHTML="";
  ctq.options.forEach(function(o,i){
    var b=document.createElement("button");
    b.type="button"; b.className="ctq-opt"; b.setAttribute("data-pick",i);
    b.innerHTML='<span class="dot"></span><span>'+o.txt+'</span>';
    b.addEventListener("click",function(){
      chosen=i;
      [].forEach.call(list.children,function(c,j){c.classList.toggle("sel",j===i)});
      $("m-warn").classList.remove("show");
    });
    list.appendChild(b);
  });
  $("mask").classList.add("open");
  document.body.classList.add("locked");
}
function closeModal(){
  $("mask").classList.remove("open");
  document.body.classList.remove("locked");
}
$("m-cancel").addEventListener("click",closeModal);
$("mask").addEventListener("click",function(e){ if(e.target===$("mask")) closeModal(); });

$("m-go").addEventListener("click",function(){
  if(chosen===null){ $("m-warn").classList.add("show"); return; }
  var k=current, pick=chosen;
  closeModal();
  if(k==="s1") revealS1(pick); else reveal(k,pick);
});

document.addEventListener("click",function(e){
  var b=e.target.closest ? e.target.closest("[data-open]") : null;
  if(!b||b.disabled) return;
  var ci=parseInt(b.getAttribute("data-open"),10);
  openModal(ci,CASES[ci].ctq,"Conduite à tenir · cas "+(ci+1));
});
$("s1-open").addEventListener("click",function(){
  openModal("s1",CTQ_S1,"Conduite à tenir · cas d'école");
});

function ctqBlock(ctq,pick){
  var good=-1;
  ctq.options.forEach(function(o,i){ if(o.ok) good=i; });
  var isOk = pick===good;
  ctqScore.total++; if(isOk) ctqScore.ok++;
  var h='<div class="ctq-res"><span class="head">Conduite à tenir — '+
        (isOk?"Vrai · réponse conforme":"Faux · réponse non conforme")+'</span>';
  h+='<div class="row '+(isOk?"good":"bad")+'"><span class="who2">Votre choix · '+(isOk?"vrai":"faux")+'</span>'+
     '<p class="prop">'+ctq.options[pick].txt+'</p>'+
     '<p class="why">'+ctq.options[pick].why+'</p></div>';
  if(!isOk){
    h+='<div class="row good"><span class="who2">La réponse conforme</span>'+
       '<p class="prop">'+ctq.options[good].txt+'</p>'+
       '<p class="why">'+ctq.options[good].why+'</p></div>';
  }
  h+='</div>';
  return h;
}

function revealS1(pick){
  $("s1-open").disabled=true;
  var box=$("s1-verdict");
  box.innerHTML=
    ctqBlock(CTQ_S1,pick)+
    '<div class="rule-out"><h3>Ce que ce cas démontre</h3>'+
    '<p>Un doublon n\'est pas seulement une gêne : c\'est une <b>zone d\'ambiguïté ouverte</b>. Tant qu\'il existe, chaque document entrant peut atterrir dans l\'un ou l\'autre dossier — et personne ne peut dire lequel est le bon. La fusion referme le doublon mais <b>scelle la collision à l\'intérieur</b>. Ce qui aurait tout évité n\'est pas une meilleure fusion : c\'est de ne jamais avoir créé le second dossier, et de traiter le doublon dans les 72 heures suivant sa détection.</p></div>';
  box.classList.add("show");
  introCaseComplete=true;
  refreshNext();
  box.scrollIntoView({behavior:"smooth",block:"nearest"});
}

function checkTimeline(ci){
  var C=CASES[ci], ul=$("tl"+ci), box=$("v"+ci);
  if(done[ci]) return;
  done[ci]=true;
  ul.classList.add("revealed");
  document.querySelector('[data-check="'+ci+'"]').disabled=true;

  var first=Math.min.apply(null,C.errors);
  [].forEach.call(ul.querySelectorAll(".ev"),function(b,i){
    if(C.errors.indexOf(i)>-1) b.classList.add("err");
    if(i>=first) b.classList.add("tainted");
  });

  var hit=0, extra=0;
  picks[ci].forEach(function(i){ if(C.errors.indexOf(i)>-1) hit++; else extra++; });
  results[ci]={hit:hit,total:C.errors.length,extra:extra};

  var stamp,msg;
  if(hit===C.errors.length && extra===0){
    stamp='<span class="stamp hit">Complet</span>';
    msg="Vous avez identifié les "+C.errors.length+" moments d'erreur, sans en ajouter.";
  } else if(hit>0){
    stamp='<span class="stamp near">Partiel</span>';
    msg=hit+" moment"+(hit>1?"s":"")+" d'erreur sur "+C.errors.length+" identifié"+(hit>1?"s":"")+
        (extra? ", et "+extra+" moment"+(extra>1?"s":"")+" retenu"+(extra>1?"s":"")+" à tort." : ".");
  } else {
    stamp='<span class="stamp miss">À revoir</span>';
    msg="Aucun des moments d'erreur n'a été retenu. Les moments cochés sont des conséquences, pas des causes.";
  }

  var bl="";
  C.barriers.forEach(function(x){
    bl+='<li><span class="when">'+x.when+'</span><span>'+x.txt+'</span></li>';
  });

  box.innerHTML=
    stamp+'<p style="font-size:1.05rem">'+msg+'</p>'+
    '<h3 style="margin-top:20px">Les moments d\'erreur</h3>'+
    '<ul class="barriers">'+bl+'</ul>'+
    (C.extraNote?'<p class="note" style="margin-top:20px">'+C.extraNote+'</p>':'');
  box.classList.add("show");
  $("ab2"+ci).classList.remove("hidden");
  refreshNext();
  box.scrollIntoView({behavior:"smooth",block:"nearest"});
}

function reveal(ci,pick){
  var C=CASES[ci], box=$("w"+ci);
  if(box.classList.contains("show")) return;
  $("ab2"+ci).classList.add("hidden");
  box.innerHTML=
    ctqBlock(C.ctq,pick)+
    '<div class="rule-out"><h3>'+C.ruleTitle+'</h3><p>'+C.rule+'</p></div>';
  box.classList.add("show");
  caseComplete[ci]=true;
  refreshNext();
  box.scrollIntoView({behavior:"smooth",block:"nearest"});
}

function updateScore(){
  var t=0,h=0,tot=0,x=0;
  results.forEach(function(r){ if(!r) return; t++; h+=r.hit; tot+=r.total; x+=r.extra; });
  var s = t===0 ? "" :
    "Cas traités : "+t+" / "+CASES.length+"  ·  moments d'erreur identifiés : "+h+" / "+tot+
    (x? "  ·  retenus à tort : "+x : "");
  if(ctqScore.total) s += (s?"  ·  ":"")+"conduites à tenir conformes : "+ctqScore.ok+" / "+ctqScore.total;
  $("scoreline").textContent=s;
}

$("restart").addEventListener("click",function(){location.reload()});

show(0);
})();
</script>
